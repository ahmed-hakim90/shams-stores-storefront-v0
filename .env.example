# Never put real credentials in this tracked template.
COMMERCE_PROVIDER=mock
WOOCOMMERCE_API_URL=https://YOUR-WORDPRESS-HOST.example/wp-json/wc/v3
# Catalog-only can use read-only keys. Checkout needs a dedicated read/write
# key owned by a user with manage_woocommerce (Shams Headless 1.2.0 required).
WOOCOMMERCE_API_KEY=
WOOCOMMERCE_API_SECRET=
WOOCOMMERCE_CURRENCY=EGP
SHAMS_CONTENT_API_ENABLED=true

# Exact public HTTPS origin of THIS frontend; separate Preview / Production.
NEXT_PUBLIC_APP_URL=https://YOUR-FRONTEND-HOST.example
COMMERCE_CHECKOUT_ENABLED=false
# Enable only after testing these Woo gateways on staging: cod,bacs
COMMERCE_VERIFIED_PAYMENT_METHODS=

# Embedded Pixel checkout. Explicitly opt in after configuration/test setup.
PAYMOB_ENABLED=false
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
# Public merchant key, returned to Pixel by the server. Not a secret.
PAYMOB_PUBLIC_KEY=
# Legacy NEXT_PUBLIC_PAYMOB_PUBLIC_KEY is also accepted; use one source only.
PAYMOB_BASE_URL=https://accept.paymob.com

# Production parity: intersects enabled Woo gateways with the approved IDs below.
# The allowlist prevents live and test integrations being mixed.
PAYMOB_METHOD_SOURCE=woocommerce
# For sandbox use environment + TEST integration IDs; never mix live site IDs
# with test keys. Comma-separated positive integers; blank means not offered.
PAYMOB_INTEGRATION_ID=
PAYMOB_INSTALLMENT_INTEGRATION_IDS=
