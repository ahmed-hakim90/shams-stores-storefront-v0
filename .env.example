# Shams Stores — Environment Configuration Template
# Copy this file to .env.local and fill in the actual values for your environment

# ========================================
# SHAMS API & WooCommerce Configuration
# ========================================

# Shams API Base URL (will replace mock data in lib/commerce/data.ts)
NEXT_PUBLIC_SHAMS_API_URL=https://api.shams-stores.com

# WooCommerce REST API Endpoint
NEXT_PUBLIC_WOOCOMMERCE_API_URL=https://shams-stores.com/wp-json/wc/v3

# WooCommerce API credentials (for server-side requests)
WOOCOMMERCE_API_KEY=your_api_key_here
WOOCOMMERCE_API_SECRET=your_api_secret_here

# Shams API authentication (for server-side requests)
SHAMS_API_KEY=your_shams_api_key_here
SHAMS_API_SECRET=your_shams_api_secret_here

# ========================================
# Payment & Installment Services
# ========================================

# Installment payment provider (e.g., Telr, Fawry, Vodafone Cash)
NEXT_PUBLIC_INSTALLMENT_PROVIDER=telr
INSTALLMENT_API_KEY=your_installment_api_key_here
INSTALLMENT_MERCHANT_ID=your_merchant_id_here

# Payment gateway configuration
NEXT_PUBLIC_PAYMENT_GATEWAY_ID=shams_stores

# ========================================
# Analytics & Monitoring
# ========================================

# Vercel Analytics (already configured via @vercel/analytics package)
# VERCEL_ANALYTICS_ID is set automatically by Vercel in production

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Facebook Pixel (optional)
NEXT_PUBLIC_FB_PIXEL_ID=

# ========================================
# Third-Party Services
# ========================================

# Email service (for notifications, receipts, etc.)
NEXT_PUBLIC_EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMS service (for OTP, order updates, etc.)
NEXT_PUBLIC_SMS_SERVICE=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+20xxxxx

# Maps & Location services (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ========================================
# Application Configuration
# ========================================

# Environment name
NODE_ENV=development

# App name and branding
NEXT_PUBLIC_APP_NAME=Shams Stores
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Currency and localization
NEXT_PUBLIC_CURRENCY_CODE=EGP
NEXT_PUBLIC_LOCALE=en-EG

# Feature flags
NEXT_PUBLIC_FEATURE_INSTALLMENTS=true
NEXT_PUBLIC_FEATURE_COMPARE=true
NEXT_PUBLIC_FEATURE_WISHLIST=true
NEXT_PUBLIC_FEATURE_BUNDLES=true
NEXT_PUBLIC_FEATURE_REVIEWS=true

# ========================================
# Cache & Performance
# ========================================

# Cache duration for product data (in seconds)
CACHE_PRODUCTS_TTL=3600

# Cache duration for category data (in seconds)
CACHE_CATEGORIES_TTL=7200

# ========================================
# Debugging & Development
# ========================================

# Enable detailed logging
DEBUG=false
NEXT_PUBLIC_DEBUG=false

# Log HTTP requests
DEBUG_HTTP_REQUESTS=false
