# mock preserves the design preview. woocommerce enables the connected catalog.
COMMERCE_PROVIDER=mock

# Server-only WooCommerce REST API credentials. Use a read-only key.

# Set EGP only after verifying WooCommerce > Settings > General > Currency.
WOOCOMMERCE_CURRENCY=EGP

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payments: Paymob (direct API + embedded Pixel) ---
# Card checkout requires a PUBLIC HTTPS NEXT_PUBLIC_APP_URL (Paymob must reach
# the webhook). For local sandbox testing use an HTTPS tunnel URL.

# Master switch for the connected checkout (also gates card payments).
COMMERCE_CHECKOUT_ENABLED=false
# Woo gateway ids allowed for non-card methods (e.g. cod). Card runs via Paymob.
COMMERCE_VERIFIED_PAYMENT_METHODS=

# Server-only Paymob secrets. NEVER expose these to the client.
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
# Card integration id(s) from the Paymob dashboard; comma-separated integers.
PAYMOB_INTEGRATION_ID=
# Optional. Defaults to https://accept.paymob.com (Egypt).
PAYMOB_BASE_URL=https://accept.paymob.com

# Client-safe merchant PUBLIC key used by the Paymob Pixel SDK in the browser.
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=
